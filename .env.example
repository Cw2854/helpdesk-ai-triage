# Copy this file, rename the copy to ".env", then fill it in.
# Never upload your real .env to GitHub or share it (the .gitignore already blocks it).

# Pick one:
#   groq   = free API key, no card needed, runs in the cloud
#   ollama = free, runs on your own computer (install from https://ollama.com first)
AI_PROVIDER=groq

# Groq only: get a free key at https://console.groq.com/keys
AI_API_KEY=

# Optional - only change these if you know you need to
# AI_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=
# REQUEST_DELAY_SECONDS=2.5

# Online only (PythonAnywhere): turns on HTTPS-only cookies and real visitor IP addresses.
# Leave it out on your own computer.
# PUBLIC_SITE=1

# Admin web app: don't type these in yourself.
# Run "python set_password.py" and it fills them in for you.
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# SECRET_KEY=
